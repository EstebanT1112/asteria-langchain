# Copiar este archivo como .env y reemplazar solamente los valores necesarios.
# Nunca subir .env al repositorio ni compartir la clave en capturas o documentos.
GOOGLE_API_KEY=
MODEL_ID=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-2

# LangSmith es opcional para la primera implementación.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=asteria-asi
